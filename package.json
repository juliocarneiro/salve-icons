{
  "name": "salve-icons",
  "version": "0.2.1",
  "description": "Icons that behave like text: 292 stroke icons on a 24px grid, social brands included. Use them as CSS classes, React components (Server Components friendly), SVG sprite, JS module or web component. They inherit color and size from the text.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/salve-icons.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "default": "./dist/sprite.js"
    },
    "./css": "./dist/salve-icons.css",
    "./element": "./dist/element.js",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./dist/icons.json",
    "./svg/*": "./dist/svg/*",
    "./build": "./lib/build.js"
  },
  "bin": {
    "salve-icons": "bin/salve-icons.js"
  },
  "files": [
    "dist",
    "src",
    "lib",
    "bin",
    "CHANGELOG.md",
    "README.pt-BR.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/element.js"
  ],
  "scripts": {
    "build": "node -e \"import('./lib/build.js').then(m => m.buildIcons()).then(r => console.log('salve-icons → dist (' + r.count + ' icons)'))\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "icon-font",
    "icons",
    "nextjs",
    "react",
    "salve",
    "server-components",
    "social-icons",
    "sprite",
    "ssr",
    "svg",
    "web-component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/salve-icons.git"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "homepage": "https://github.com/juliocarneiro/salve-icons#readme",
  "bugs": {
    "url": "https://github.com/juliocarneiro/salve-icons/issues"
  },
  "author": "Julio Carneiro"
}
